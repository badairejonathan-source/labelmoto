rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images en attente de validation (upload par les pros authentifiés)
    match /pending_images/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // max 5 Mo
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // Images approuvées et publiées (lecture publique)
    match /fiches_images/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in ["A36FqeWBHjQBLKQMaMSiFVBzGV22", "A366V1X8Hqf1pA63nU3N8B7l8fD3", "f7xVfH8R8mS5v8H7N3nU3N8B7l8f"]
        || request.auth.token.email == "badjoe950@hotmail.com"
      );
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS DE BASE ---
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Vérification directe sur le jeton d'authentification Firebase.
     * C'est la méthode la plus rapide et la plus sûre car elle est signée cryptographiquement.
     */
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    /**
     * Récupération dynamique du rôle depuis le document NOYAU Firestore.
     * Cette méthode est flexible car elle permet de changer le rôle sans forcer
     * l'utilisateur à se reconnecter (contrairement aux Custom Claims).
     */
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /**
     * Prêt pour migration Custom Claims : plus tard, on pourra simplement faire
     * return isSignedIn() && request.auth.token.admin == true;
     */
    function isAdmin() {
      return isSignedIn() && getRole() == "admin";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- NOYAU IDENTITÉ (users) ---
    // Source de vérité : l'utilisateur peut toujours lire son propre document identity
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // On interdit à l'utilisateur de changer son propre rôle lors d'un update
      allow update: if isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin());
      allow list: if isAdmin();
    }

    // --- COLLECTIONS PUBLIQUES ---
    match /concessions/{dealershipId} {
      allow read: if true;
      allow write: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        // OBLIGATION : Seuls les comptes avec email vérifié peuvent poster un avis
        // Cela garantit la qualité de la donnée et limite le spam.
        allow write: if isEmailVerified() || isAdmin();
      }
    }
    
    match /associations/{associationId} { allow read: if true; allow write: if isAdmin(); }
    match /relais/{relaisId} { allow read: if true; allow write: if isAdmin(); }
    match /motorcycle_sheets/{modelId} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{articleId} { allow read: if true; allow write: if isAdmin(); }

    // --- QUARANTAINE & SOUMISSIONS ---
    match /listing_submissions/{submissionId} {
      allow create: if true; // Soumission publique autorisée
      allow read, update, delete: if isAdmin();
    }
    
    match /pending_comments/{commentId} {
      allow create: if isSignedIn(); // N'importe quel utilisateur connecté peut soumettre
      allow read, update, delete: if isAdmin();
    }

    // --- EXTENSIONS MÉTIER (Profils spécifiques) ---
    match /standardProfiles/{userId} {
      allow get, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /professionalProfiles/{professionalId} {
      allow get, create, update: if isOwner(professionalId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
  }
}
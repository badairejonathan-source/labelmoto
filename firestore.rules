/**
 * Moto Trust Firestore Security Rules
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == "A36FqeWBHjQBLKQMaMSiFVBzGV22";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTIONS PUBLIQUES (LECTURE SEULE POUR TOUS, ÉCRITURE ADMIN) ---
    // Verrouillage strict : les pros ne peuvent plus écrire ici directement
    match /concessions/{dealershipId} {
      allow read: if true;
      allow write: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /associations/{associationId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /relais/{relaisId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /motorcycle_sheets/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- SOUMISSIONS PROS (SAS DE QUARANTAINE) ---
    // Les écritures se font via Server Actions, mais on garde une règle de sécurité par précaution
    match /listing_submissions/{submissionId} {
      allow create: if true; // Autorisé via formulaire public / Server Actions
      allow read, update, delete: if isAdmin();
    }
    
    // Ancien sas de soumission (deprecated but kept for ongoing processes)
    match /pending_concessions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /pending_comments/{commentId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // --- PROFILS UTILISATEURS ---
    match /standardProfiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }
    match /professionalProfiles/{professionalId} {
      allow get: if isOwner(professionalId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(professionalId);
      allow update: if isOwner(professionalId);
      allow delete: if isAdmin();
    }

    match /roles_admin/{uid} {
      allow read, write: if isAdmin();
    }
  }
}

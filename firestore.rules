
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS DE BASE ---
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Vérification directe sur le jeton d'authentification Firebase.
     */
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    /**
     * Vérification Admin : document Firestore OU identifiants de secours prioritaires.
     * Les UIDs et emails listés ici sont des "Master Admins" qui ont tous les droits.
     */
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
        || request.auth.uid == "A36FqeWBHjQBLKQMaMSiFVBzGV22"
        || request.auth.token.email == "badjoe950@hotmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- NOYAU IDENTITÉ (users) ---
    match /users/{userId} {
      // Un admin a un contrôle total (list, create, get, update, delete)
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // --- COLLECTIONS PUBLIQUES ---
    match /concessions/{dealershipId} {
      allow read: if true;
      allow write: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        // OBLIGATION : Seuls les comptes avec email vérifié peuvent poster un avis
        allow write: if isEmailVerified() || isAdmin();
      }
    }
    
    match /associations/{associationId} { allow read: if true; allow write: if isAdmin(); }
    match /relais/{relaisId} { allow read: if true; allow write: if isAdmin(); }
    match /motorcycle_sheets/{modelId} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{articleId} { allow read: if true; allow write: if isAdmin(); }

    // --- QUARANTAINE & SOUMISSIONS ---
    match /listing_submissions/{submissionId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }
    
    match /pending_comments/{commentId} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if isAdmin();
    }

    // --- EXTENSIONS MÉTIER ---
    match /standardProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /professionalProfiles/{professionalId} {
      allow read, write: if isOwner(professionalId) || isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
  }
}

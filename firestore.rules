rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS DE BASE ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid in ["A36FqeWBHjQBLKQMaMSiFVBzGV22", "A366V1X8Hqf1pA63nU3N8B7l8fD3", "f7xVfH8R8mS5v8H7N3nU3N8B7l8f"]
        || request.auth.token.email == "badjoe950@hotmail.com"
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTIONS PUBLIQUES (VITRINE) ---
    // Lecture libre pour tous, écriture réservée aux admins
    match /concessions/{id} { 
      allow read: if true; 
      allow write: if isAdmin();
      // Stats publiques (clics téléphone, site web)
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats_tel','stats_web','stats_vues']); 
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    match /associations/{id} { allow read: if true; allow write: if isAdmin(); }
    match /relais/{id} { allow read: if true; allow write: if isAdmin(); }
    match /creators/{id} { allow read: if true; allow write: if isAdmin(); }
    match /motorcycle_sheets/{id} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{id} { allow read: if true; allow write: if isAdmin(); }
    // Cache public (choropleth départements)
    match /cache/{id} { allow read: if true; allow write: if isAdmin(); }
    // Prospection B2B — lecture/écriture admin uniquement
    match /prospection/{id} { allow read, write: if isAdmin(); }
    // Demandes d'images — pros authentifiés peuvent créer, admin peut tout
    match /image_requests/{id} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- NOYAU IDENTITÉ & PROFILS ---
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
    }
    
    match /standardProfiles/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }
    
    match /professionalProfiles/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }

    // --- SOUMISSIONS & CONTACT ---
    match /listing_submissions/{id} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }
    
    // --- DEMANDES DE MODIFICATION DE FICHE (revendication pro) ---
    match /modification_requests/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /pending_comments/{id} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if isAdmin();
    }

    match /contact_messages/{id} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
    
    match /migration_runs/{id} {
      allow read, write: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS DE BASE ---
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Vérification directe sur le jeton d'authentification Firebase.
     */
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    /**
     * Récupération dynamique du rôle depuis le document NOYAU Firestore.
     */
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /**
     * Vérification Admin basée sur le document noyau.
     */
    function isAdmin() {
      return isSignedIn() && getRole() == "admin";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- NOYAU IDENTITÉ (users) ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // On interdit de changer son propre rôle lors d'un update
      allow update: if isOwner(userId) && (
        (request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid)
        || isAdmin()
      );
      allow list: if isAdmin();
    }

    // --- COLLECTIONS PUBLIQUES ---
    match /concessions/{dealershipId} {
      allow read: if true;
      allow write: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        // OBLIGATION : Seuls les comptes avec email vérifié peuvent poster un avis
        allow write: if isEmailVerified() || isAdmin();
      }
    }
    
    match /associations/{associationId} { allow read: if true; allow write: if isAdmin(); }
    match /relais/{relaisId} { allow read: if true; allow write: if isAdmin(); }
    match /motorcycle_sheets/{modelId} { allow read: if true; allow write: if isAdmin(); }
    match /articles/{articleId} { allow read: if true; allow write: if isAdmin(); }

    // --- QUARANTAINE & SOUMISSIONS ---
    match /listing_submissions/{submissionId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }
    
    match /pending_comments/{commentId} {
      allow create: if isSignedIn(); 
      allow read, update, delete: if isAdmin();
    }

    // --- EXTENSIONS MÉTIER ---
    match /standardProfiles/{userId} {
      allow get, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /professionalProfiles/{professionalId} {
      allow get, create, update: if isOwner(professionalId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
  }
}
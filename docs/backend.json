
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Document central d'identité utilisateur.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "pro", "admin"] },
        "status": { "type": "string", "enum": ["pending_verification", "active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "onboardingComplete": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Dealership": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Dealership",
      "type": "object",
      "description": "Represents an approved and active motorcycle dealership listed in the Moto Trust application.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "rating": { "type": "number" },
        "category": { "type": "string" },
        "appSection": { "type": "string", "enum": ["shopping", "service", "both"] },
        "brands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Association": {
      "title": "Association",
      "type": "object",
      "description": "Représente une association motarde ou un club.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "address": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "phoneNumber": { "type": "string" },
        "allPhoneNumbers": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "string" },
        "emails": { "type": "array", "items": { "type": "string" } },
        "website": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "associationType": { "type": "string" },
        "activities": { "type": "array", "items": { "type": "string" } },
        "targetAudience": { "type": "array", "items": { "type": "string" } },
        "sourceUrl": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "appSection": { "type": "string", "enum": ["association"] }
      }
    },
    "Relais": {
      "title": "Relais",
      "type": "object",
      "description": "Représente un relais motard (bar, hôtel, restaurant).",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "pnoneNumber": { "type": "string" },
        "website": { "type": "string" },
        "rating": { "type": "string" },
        "reviewCount": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "appSection": { "type": "string", "enum": ["relais"] }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Données centrales d'identité utilisateur."
    },
    "/concessions/{dealershipId}": {
      "schema": { "$ref": "#/backend/entities/Dealership" },
      "description": "Liste des concessions et ateliers moto."
    },
    "/associations/{associationId}": {
      "schema": { "$ref": "#/backend/entities/Association" },
      "description": "Liste des associations motardes."
    },
    "/relais/{relaisId}": {
      "schema": { "$ref": "#/backend/entities/Relais" },
      "description": "Liste des relais motards (bars, hôtels)."
    }
  }
}
